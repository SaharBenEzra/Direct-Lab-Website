# Copy this file to .env and fill in real values. .env is gitignored — never commit real credentials.
#
# SMTP_USER: the Gmail address submissions get sent FROM.
# SMTP_PASS: a Gmail "App Password" for that account (Google Account > Security >
#            2-Step Verification > App passwords) — NOT the regular account password.
#
# The recipient address (NOTIFY_EMAIL) is not a secret and is set directly in
# app.py instead of here (or override it with a NOTIFY_EMAIL var here too).
#
# MONGO_URI: only needed for "plain Python" local runs (see README). Not
# needed with docker-compose, which wires this up itself.

SMTP_USER=
SMTP_PASS=
# MONGO_URI=mongodb://localhost:27017
