# Copy to values.secrets.yaml (gitignored — never commit real credentials)
# and fill in real values. Install/upgrade with both files:
#
#   helm upgrade --install direct-lab ./charts/direct-lab \
#     -f charts/direct-lab/values.yaml \
#     -f charts/direct-lab/values.secrets.yaml
#
# app.mongoPassword and mongodb.auth.passwords[0] must be the SAME value —
# one is what the app connects with, the other is what Mongo is told to
# accept for that user.

app:
  mongoPassword: "REPLACE_ME"
  smtp:
    user: "REPLACE_ME@gmail.com"
    pass: "REPLACE_ME"   # Gmail App Password, not the account password

mongodb:
  auth:
    rootPassword: "REPLACE_ME"
    passwords: ["REPLACE_ME"]   # same value as app.mongoPassword above
